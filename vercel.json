{
  "outputDirectory": "website",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/learning-review",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/technician",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "review/resources-platform-v060": false,
      "review/resources-folders-design-v061": false,
      "review/owner-publishing-recovery": false
    }
  }
}
