{
  "outputDirectory": "website",
  "buildCommand": "node scripts/generate-config.cjs",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/learning-review", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/admin", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/app", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/technician", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
