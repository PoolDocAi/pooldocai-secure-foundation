{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/resources/collections/:collectionPath([a-z0-9-]+(?:/[a-z0-9-]+)+)/",
      "destination": "/api/review?__path=/resources/collections/:collectionPath/"
    },
    {
      "source": "/resources/collections/:path*",
      "destination": "/api/review?__path=/resources/collections/:path*"
    },
    {
      "source": "/resources/",
      "destination": "/api/review?__path=/resources/"
    },
    {
      "source": "/resources",
      "destination": "/api/review?__path=/resources"
    },
    {
      "source": "/api/public/resources",
      "destination": "/api/review?__path=/api/public/resources"
    },
    {
      "source": "/analytics/collect",
      "destination": "/api/review?__path=/analytics/collect"
    },
    {
      "source": "/api/review-mode",
      "destination": "/api/review?__path=/api/review-mode"
    },
    {
      "source": "/public/:asset*",
      "destination": "/:asset*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-UzfK5VgY11o7T9BtOY3Q6sHMid5P8QyFd282tQRFh8A=' https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com https://www.facebook.com; connect-src 'self' https://formspree.io https://www.google-analytics.com https://region1.google-analytics.com https://www.facebook.com; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'none'"
        }
      ]
    }
  ]
}
