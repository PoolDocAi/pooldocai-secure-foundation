    "test:production": "node --test tests/production-adapters.test.mjs tests/serverless-app.test.mjs tests/production-e2e-pglite.test.mjs tests/migration-static.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "backup": "node scripts/backup.mjs",
    "preview:local": "node scripts/preview-local.mjs",
    "test:postgres": "node tests/postgres-proposal.mjs && node tests/postgres-commands.mjs && node tests/postgres-storage.mjs",
    "prepare:priority-drafts": "node scripts/prepare-priority-drafts.mjs",
    "import:priority-drafts:local": "node scripts/import-priority-drafts-local.mjs",
    "prepare:approved-content": "node scripts/prepare-approved-resources.mjs",
