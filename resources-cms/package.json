    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.11",
    "@sparticuz/chromium": "153.0.0",
    "playwright": "1.64.1"
  }
